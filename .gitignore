# Personal data (user fills these)
cv.md
article-digest.md
interview-prep/*
!interview-prep/.gitkeep
data/career-context*.md
data/applications.md
data/pipeline.md
data/scan-history.tsv
data/parser-output/**/*.json
!data/parser-output/.gitkeep
!data/parser-output/**/.gitkeep
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Secrets (never commit — use .env.example as template)
.env

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# Backup files written by normalize-statuses.mjs / dedup-tracker.mjs
*.bak

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard
dashboard.html
package-lock.json

# Playwright MCP server run artifacts (ephemeral, machine-local — never commit)
.playwright-mcp/

# --- User-layer data that must never reach this PUBLIC fork (added 2026-09-09) ---
# `data/` is user-layer per DATA_CONTRACT.md, and .github/workflows/no-user-data.yml
# already blocks it -- but ONLY `on: pull_request`. This fork commits directly to
# main, so that guard is structurally bypassed and has never once fired here.
#
# data/pdf-index.tsv is written by generate-pdf.mjs and names the source HTML for
# every document built -- i.e. the COMPANY and the DATE of each application. It was
# committed on 2026-09-02 and would have published a live, dated application record
# to a public repo. The job search is confidential.
data/pdf-index.tsv
